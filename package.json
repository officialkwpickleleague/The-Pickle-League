{
  "name": "pickle-league",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 migrations apply pickle-league-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply pickle-league-db --remote"
  },
  "dependencies": {
    "next": "15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "leaflet": "1.9.4",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "tailwindcss": "^3.4.1",
    "postcss": "^8",
    "autoprefixer": "^10",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260708.1": true
  }
}
